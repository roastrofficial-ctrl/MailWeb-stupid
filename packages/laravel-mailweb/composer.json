{
    "name": "mailweb/laravel-mailweb",
    "description": "Publish transport-independent MailWeb documents from Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0",
        "symfony/mailer": "^7.0"
    },
    "autoload": {
        "psr-4": {"MailWeb\\Laravel\\": "src/"}
    },
    "extra": {
        "laravel": {
            "providers": ["MailWeb\\Laravel\\MailWebServiceProvider"],
            "aliases": {"MailWeb": "MailWeb\\Laravel\\Facades\\MailWeb"}
        }
    }
}
