{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MailWebRequest",
  "description": "A transport-independent request for a MailWeb document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mailweb", "id", "method", "uri", "headers"],
  "properties": {
    "mailweb": { "const": "0.4" },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "A canonical, uppercase ULID used to correlate the response."
    },
    "method": { "enum": ["GET", "POST"] },
    "uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^mailweb://",
      "description": "The absolute mailweb URI of the requested document."
    },
    "headers": {
      "type": "object",
      "description": "Protocol metadata. Header names are case-insensitive.",
      "propertyNames": { "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$" },
      "additionalProperties": { "type": "string" }
    },
    "body": {
      "type": "object",
      "description": "JSON-compatible application data. Present on POST and absent on GET."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "method": { "const": "GET" } } },
      "then": { "not": { "required": ["body"] } }
    },
    {
      "if": { "properties": { "method": { "const": "POST" } } },
      "then": { "required": ["body"] }
    }
  ]
}
