{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MailWebDocument",
  "description": "A safe, declarative document made from MailWeb nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "body"],
  "properties": {
    "title": { "type": "string", "maxLength": 512 },
    "body": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/node" }
    },
    "presentation": { "$ref": "#/$defs/presentation" },
    "template": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$" },
    "template_version": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "slots": { "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" }, "additionalProperties": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/contentNode" } } }
  },
  "allOf": [{
    "if": { "required": ["template"] },
    "then": { "required": ["template_version", "slots"], "properties": { "body": { "maxItems": 0 } } },
    "else": { "not": { "anyOf": [{ "required": ["template_version"] }, { "required": ["slots"] }] } }
  }],
  "$defs": {
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/link" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/button" },
        { "$ref": "#/$defs/revisit" },
        { "$ref": "#/$defs/form" },
        { "$ref": "#/$defs/nav" },
        { "$ref": "#/$defs/slot" },
        { "$ref": "#/$defs/attachment" },
        { "$ref": "#/$defs/clientAction" }
      ]
    },
    "contentNode": {
      "oneOf": [
        { "$ref": "#/$defs/heading" }, { "$ref": "#/$defs/paragraph" }, { "$ref": "#/$defs/link" },
        { "$ref": "#/$defs/image" }, { "$ref": "#/$defs/button" }, { "$ref": "#/$defs/revisit" }, { "$ref": "#/$defs/form" }, { "$ref": "#/$defs/nav" }, { "$ref": "#/$defs/attachment" }, { "$ref": "#/$defs/clientAction" }
      ]
    },
    "navItem": { "type": "object", "additionalProperties": false, "required": ["label", "href"], "properties": { "label": { "type": "string", "minLength": 1 }, "href": { "type": "string", "format": "uri-reference", "minLength": 1 } } },
    "nav": {
      "type": "object", "additionalProperties": false, "required": ["type", "label", "items"],
      "properties": {
        "type": { "const": "nav" }, "label": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/navItem" } }
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["type", "name"],
      "properties": { "type": { "const": "slot" }, "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" } }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "text"],
      "properties": {
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "type": "string" },
        "variant": { "enum": ["normal", "display"] }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "href"],
      "properties": {
        "type": { "const": "link" },
        "label": { "type": "string" },
        "href": { "type": "string", "format": "uri-reference", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "alt"],
      "properties": {
        "type": { "const": "image" },
        "src": { "type": "string", "format": "uri-reference", "minLength": 1 },
        "enclosure": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "alt": { "type": "string" },
        "variant": { "enum": ["normal", "hero"] }
      },
      "oneOf": [{ "required": ["src"], "not": { "required": ["enclosure"] } }, { "required": ["enclosure", "digest"], "not": { "required": ["src"] } }]
    },
    "attachment": { "type": "object", "additionalProperties": false, "required": ["type", "enclosure", "digest", "label"], "properties": { "type": { "const": "attachment" }, "enclosure": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "label": { "type": "string", "minLength": 1 }, "description": { "type": "string" } } },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "href"],
      "properties": {
        "type": { "const": "button" },
        "label": { "type": "string" },
        "href": { "type": "string", "format": "uri-reference", "minLength": 1 },
        "variant": { "enum": ["normal", "prominent"] }
      }
    },
    "revisit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "href", "after_ms"],
      "properties": {
        "type": { "const": "revisit" },
        "href": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "after_ms": { "type": "integer", "minimum": 250, "maximum": 10000 }
      }
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "label"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
        "type": { "const": "text" },
        "label": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "method", "action", "fields", "submit"],
      "properties": {
        "type": { "const": "form" },
        "method": { "enum": ["GET", "POST"] },
        "action": { "type": "string", "format": "uri-reference", "minLength": 1 },
        "fields": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/formField" } },
        "submit": { "type": "string", "minLength": 1 }
      }
    },
    "clientAction": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "label", "capability", "action", "parameters", "discloses"],
      "properties": {
        "type": { "const": "client_action" },
        "label": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
        "action": { "type": "string", "format": "uri-reference", "minLength": 1 },
        "parameters": { "type": "object", "maxProperties": 32, "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" }, "additionalProperties": { "type": "string" } },
        "discloses": { "type": "array", "maxItems": 32, "items": { "type": "string" } }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "foreground": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "typeface": { "enum": ["system", "editorial", "sans", "mono"] },
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "corners": { "enum": ["square", "soft", "round"] }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
